{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rag-belajar-app",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-10",
	"vars": {
		"ENABLE_DEBUG": "false"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "LIMITER",
				"class_name": "RateLimiter"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RateLimiter"]
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"r2_buckets": [
		{
			"binding": "DOCS",
			"bucket_name": "rag-docs"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rag",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"vectorize": [
		{
			"binding": "INDEX",
			"index_name": "rag-index",
			"remote": true
		}
	]
}
